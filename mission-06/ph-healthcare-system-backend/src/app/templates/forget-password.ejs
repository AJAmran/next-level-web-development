<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset - PH Healthcare System</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background: #f4f7fb;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial,
          sans-serif;
        color: #1f2937;
      }

      .email-wrapper {
        width: 100%;
        padding: 40px 16px;
      }

      .container {
        width: 100%;
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e8edf3;
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.08);
      }

      /* Header */
      .header {
        padding: 32px 32px 28px;
        text-align: center;
        background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%);
        border-bottom: 1px solid #eef2f7;
      }

      .logo {
        width: 48px;
        height: 48px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #2563eb;
        color: #ffffff;
        font-size: 22px;
        font-weight: 700;
      }

      .brand {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        color: #111827;
      }

      .brand-subtitle {
        margin: 6px 0 0;
        font-size: 13px;
        color: #6b7280;
      }

      /* Content */
      .content {
        padding: 36px 40px 40px;
      }

      .icon-wrapper {
        width: 56px;
        height: 56px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eff6ff;
        color: #2563eb;
        font-size: 24px;
      }

      .title {
        margin: 0;
        text-align: center;
        font-size: 26px;
        line-height: 1.3;
        font-weight: 700;
        color: #111827;
      }

      .description {
        margin: 12px auto 0;
        max-width: 420px;
        text-align: center;
        font-size: 15px;
        line-height: 1.7;
        color: #6b7280;
      }

      .user-name {
        color: #111827;
        font-weight: 600;
      }

      /* OTP */
      .otp-section {
        margin: 30px 0;
        padding: 24px;
        text-align: center;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
      }

      .otp-label {
        margin: 0 0 12px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: #6b7280;
      }

      .otp {
        display: inline-block;
        padding: 14px 24px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        color: #1d4ed8;
        font-size: 32px;
        line-height: 1;
        font-weight: 700;
        letter-spacing: 8px;
        font-family: "Courier New", monospace;
      }

      .expiry {
        margin: 14px 0 0;
        font-size: 13px;
        color: #6b7280;
      }

      .expiry strong {
        color: #374151;
      }

      /* Security Notice */
      .notice {
        display: flex;
        gap: 12px;
        margin-top: 24px;
        padding: 16px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 10px;
      }

      .notice-icon {
        flex-shrink: 0;
        font-size: 17px;
      }

      .notice-text {
        margin: 0;
        font-size: 13px;
        line-height: 1.6;
        color: #92400e;
      }

      /* Footer */
      .footer {
        padding: 24px 32px;
        text-align: center;
        background: #f8fafc;
        border-top: 1px solid #eef2f7;
      }

      .footer-text {
        margin: 0;
        font-size: 12px;
        line-height: 1.6;
        color: #9ca3af;
      }

      .footer-brand {
        margin-top: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #6b7280;
      }

      /* Responsive */
      @media only screen and (max-width: 600px) {
        .email-wrapper {
          padding: 20px 12px;
        }

        .header {
          padding: 28px 20px 24px;
        }

        .content {
          padding: 30px 22px;
        }

        .title {
          font-size: 23px;
        }

        .description {
          font-size: 14px;
        }

        .otp-section {
          padding: 20px 12px;
        }

        .otp {
          padding: 13px 18px;
          font-size: 27px;
          letter-spacing: 6px;
        }

        .footer {
          padding: 20px;
        }
      }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <div class="container">

        <!-- Header -->
        <div class="header">
          <div class="logo">PH</div>

          <h1 class="brand">PH Healthcare System</h1>

          <p class="brand-subtitle">
            Secure &amp; Reliable Healthcare Management
          </p>
        </div>

        <!-- Main Content -->
        <div class="content">

          <div class="icon-wrapper">
            🔐
          </div>

          <h2 class="title">
            Password Reset Request
          </h2>

          <p class="description">
            Hello
            <span class="user-name"><%= name %></span>,
            we received a request to reset your password.
          </p>

          <p class="description">
            Use the verification code below to continue.
          </p>

          <!-- OTP -->
          <div class="otp-section">
            <p class="otp-label">Your Verification Code</p>

            <div class="otp">
              <%= otp %>
            </div>

            <p class="expiry">
              This code will expire in
              <strong><%= expirationMinutes %> minutes</strong>.
            </p>
          </div>

          <!-- Security Notice -->
          <div class="notice">
            <div class="notice-icon">⚠️</div>

            <p class="notice-text">
              If you didn't request a password reset, you can safely ignore
              this email. Never share this verification code with anyone.
            </p>
          </div>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p class="footer-text">
            This is an automated message. Please do not reply to this email.
          </p>

          <p class="footer-brand">
            &copy; <%= new Date().getFullYear() %> PH Healthcare System.
            All rights reserved.
          </p>
        </div>

      </div>
    </div>
  </body>
</html>