<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful - PH Healthcare System</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background: #f4f7fb;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial,
          sans-serif;
        color: #1f2937;
      }

      .email-wrapper {
        width: 100%;
        padding: 40px 16px;
      }

      .container {
        width: 100%;
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e8edf3;
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.08);
      }

      /* Header */
      .header {
        padding: 32px 32px 28px;
        text-align: center;
        background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
        border-bottom: 1px solid #eef2f7;
      }

      .logo {
        width: 48px;
        height: 48px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #16a34a;
        color: #ffffff;
        font-size: 22px;
        font-weight: 700;
      }

      .brand {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        color: #111827;
      }

      .brand-subtitle {
        margin: 6px 0 0;
        font-size: 13px;
        color: #6b7280;
      }

      /* Content */
      .content {
        padding: 40px;
        text-align: center;
      }

      .success-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #ecfdf3;
        border: 1px solid #bbf7d0;
        color: #16a34a;
        font-size: 34px;
        font-weight: 700;
        box-shadow: 0 4px 14px rgba(22, 163, 74, 0.12);
      }

      .title {
        margin: 0;
        font-size: 26px;
        line-height: 1.3;
        font-weight: 700;
        color: #111827;
      }

      .description {
        max-width: 430px;
        margin: 14px auto 0;
        font-size: 15px;
        line-height: 1.7;
        color: #6b7280;
      }

      .user-name {
        color: #111827;
        font-weight: 600;
      }

      /* Confirmation Card */
      .confirmation {
        margin-top: 30px;
        padding: 20px;
        text-align: left;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
      }

      .confirmation-title {
        margin: 0 0 8px;
        font-size: 14px;
        font-weight: 700;
        color: #374151;
      }

      .confirmation-text {
        margin: 0;
        font-size: 13px;
        line-height: 1.6;
        color: #6b7280;
      }

      /* Security Notice */
      .notice {
        display: flex;
        gap: 12px;
        margin-top: 20px;
        padding: 16px;
        text-align: left;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 10px;
      }

      .notice-icon {
        flex-shrink: 0;
        font-size: 17px;
      }

      .notice-text {
        margin: 0;
        font-size: 13px;
        line-height: 1.6;
        color: #92400e;
      }

      /* Footer */
      .footer {
        padding: 24px 32px;
        text-align: center;
        background: #f8fafc;
        border-top: 1px solid #eef2f7;
      }

      .footer-text {
        margin: 0;
        font-size: 12px;
        line-height: 1.6;
        color: #9ca3af;
      }

      .footer-brand {
        margin-top: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #6b7280;
      }

      /* Responsive */
      @media only screen and (max-width: 600px) {
        .email-wrapper {
          padding: 20px 12px;
        }

        .header {
          padding: 28px 20px 24px;
        }

        .content {
          padding: 30px 22px;
        }

        .title {
          font-size: 23px;
        }

        .description {
          font-size: 14px;
        }

        .success-icon {
          width: 60px;
          height: 60px;
          font-size: 30px;
        }

        .footer {
          padding: 20px;
        }
      }
    </style>
  </head>

  <body>
    <div class="email-wrapper">
      <div class="container">

        <!-- Header -->
        <div class="header">
          <div class="logo">PH</div>

          <h1 class="brand">PH Healthcare System</h1>

          <p class="brand-subtitle">
            Secure &amp; Reliable Healthcare Management
          </p>
        </div>

        <!-- Main Content -->
        <div class="content">

          <!-- Success Icon -->
          <div class="success-icon">
            &#10003;
          </div>

          <h2 class="title">
            Password Reset Successful
          </h2>

          <p class="description">
            Hello
            <span class="user-name"><%= name %></span>,
            your password has been changed successfully.
          </p>

          <p class="description">
            You can now securely log in to your PH Healthcare System account
            using your new password.
          </p>

          <!-- Confirmation -->
          <div class="confirmation">
            <p class="confirmation-title">
              Your account is secure
            </p>

            <p class="confirmation-text">
              Your previous password is no longer valid. Please use your new
              password the next time you sign in.
            </p>
          </div>

          <!-- Security Notice -->
          <div class="notice">
            <div class="notice-icon">⚠️</div>

            <p class="notice-text">
              If you did not make this change, please contact our support team
              immediately to secure your account.
            </p>
          </div>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p class="footer-text">
            This is an automated message. Please do not reply to this email.
          </p>

          <p class="footer-brand">
            &copy; <%= new Date().getFullYear() %> PH Healthcare System.
            All rights reserved.
          </p>
        </div>

      </div>
    </div>
  </body>
</html>